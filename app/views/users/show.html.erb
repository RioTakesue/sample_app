<%# ユーザ表示ビューに名前とGravatarを表示する %>
<%# ユーザのshowビューにサイドバーを追加する %>

<% provide(:title, @user.name) %>
<div class="row">
    <aide class="col-md-4">
        <section class="user_info">
            <h1>
                <%= gravatar_for @user %>
                <%= @user.name %>
            </h1>
        </section>
    </aside>
</div>