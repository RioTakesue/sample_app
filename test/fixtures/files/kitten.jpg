        text-decoration: underline;
      }

      #container {
        min-height: 100vh;
        display: grid;
        justify-items: center;
        align-items: stretch;
        grid-template-columns: 1fr;
        grid-template-rows: max-content auto max-content;
        box-sizing: border-box;
        padding: 0 20px;
      }

      header {
        text-align: center;
        margin-top: 10vh;
      }

      main {
        text-align: center;
      }

      .org-name {
        margin: 20px 0 0 0;
        font-style: normal;
        font-weight: bold;
